# Self-hosted Supabase (READ-ONLY: only used to dump data via psql SELECT)
SUPABASE_DB_CONTAINER=iheardthislive-supabase-vd0g7y-supabase-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# PocketBase target
PB_URL=https://pb.your-domain
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Optional: speeds up self-hosted avatar migration by reading files from disk
# instead of HTTP. Path = where Supabase stored the `images` bucket.
SUPABASE_LOCAL_AVATAR_DIR=/etc/dokploy/compose/iheardthislive-supabase-vd0g7y/files/volumes/storage/stub/stub/images/avatars
# The hostname that appears in self-hosted avatar URLs (so the script knows
# which URLs to resolve locally vs. fetch over HTTP). Leave blank if all
# avatars are external (e.g. Google).
SUPABASE_PUBLIC_HOST=api.iheardthis.live
